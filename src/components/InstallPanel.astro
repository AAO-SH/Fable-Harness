---
import { site } from "@/data/site";
---

<div class="install-grid">
  <article class="command-card">
    <div class="command-card-header">
      <span>{site.install.promptLabel}</span>
      <button type="button" data-copy-target="install-prompt-command" aria-label="Copy prompt install command">
        Copy
      </button>
    </div>
    <pre><code id="install-prompt-command">{site.hero.promptCommand}</code></pre>
  </article>
  <article class="command-card">
    <div class="command-card-header">
      <span>{site.install.manualLabel}</span>
      <button type="button" data-copy-target="manual-command" aria-label="Copy manual install command">
        Copy
      </button>
    </div>
    <pre><code id="manual-command">{site.hero.manualCommand}</code></pre>
    <p>{site.install.manualNote}</p>
  </article>
</div>
